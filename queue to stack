def twoStacks(maxSum, a, b):
    sum_used = 0
    count = 0
    i = 0
    j = 0

   
    while i < len(a) and sum_used + a[i] <= maxSum:
        sum_used += a[i]
        i += 1
    
    
    count = i

    
    while j < len(b) and (i >= 0):
        sum_used += b[j]
        j += 1

        
        while sum_used > maxSum and i > 0:
            i -= 1
            sum_used -= a[i]

        if sum_used <= maxSum:
            count = max(count, i + j)

    return count

if _name_ == '_main_':
